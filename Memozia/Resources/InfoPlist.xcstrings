    "NSAudioCaptureUsageDescription" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Memozia إلى الوصول إلى صوت النظام لتسجيل صوت الاجتماعات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memozia benötigt Zugriff auf Systemaudio, um den Ton von Besprechungen aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memozia needs access to system audio to record meeting sound."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memozia necesita acceder al audio del sistema para grabar el sonido de las reuniones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memozia a besoin d’accéder au son système pour enregistrer les réunions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memozia को मीटिंग की आवाज़ रिकॉर्ड करने के लिए सिस्टम ऑडियो तक पहुँच चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memozia memerlukan akses audio sistem untuk merekam suara rapat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memozia richiede l’accesso all’audio di sistema per registrare il suono delle riunioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memozia は会議の音声を録音するためにシステム音声へのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memozia는 회의 소리를 녹음하기 위해 시스템 오디오 접근 권한이 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memozia heeft toegang tot systeemaudio nodig om het geluid van vergaderingen op te nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memozia wymaga dostępu do dźwięku systemowego, aby nagrywać dźwięk spotkań."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Memozia precisa de acesso ao áudio do sistema para gravar o som das reuniões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memozia нужен доступ к системному звуку для записи звука встреч."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memozia behöver tillgång till systemljud för att spela in mötesljud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memozia ต้องเข้าถึงเสียงระบบเพื่อบันทึกเสียงการประชุม"
