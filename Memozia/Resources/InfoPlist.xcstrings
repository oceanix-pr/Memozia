    "NSRemindersUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Memozia إلى الوصول إلى التذكيرات لكتابة المهام المستخرجة بالذكاء الاصطناعي في تذكيرات النظام."
