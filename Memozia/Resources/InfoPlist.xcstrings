        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memozia потрібен доступ до системного звуку, щоб записувати звук зустрічей."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memozia cần truy cập âm thanh hệ thống để ghi lại âm thanh cuộc họp."
